{
  "name": "nen",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0"
  },
  "tasks": {
    "start":      "deno run --allow-read --allow-net --allow-env --allow-write=/tmp --allow-ffi src/main.ts",
    "dev":        "deno run --watch --allow-read --allow-net --allow-env --allow-write=/tmp --allow-ffi src/main.ts",
    "test":       "deno test --allow-read --allow-env --allow-write --allow-ffi --allow-net src/**/*.test.ts scripts/**/*.test.ts",
    "test:shell": "zsh shell/nen.test.zsh",
    "check":      "deno check src/**/*.ts scripts/**/*.ts",
    "compile":    "deno compile --allow-read --allow-net --allow-env --allow-write=/tmp --allow-ffi --target aarch64-apple-darwin --output nen src/main.ts",
    "install":    "deno run --allow-read --allow-write --allow-env --allow-run scripts/install.ts"
  },
  "fmt": { "lineWidth": 100, "semiColons": true, "singleQuote": false, "indentWidth": 2 },
  "lint": { "rules": { "include": ["no-unused-vars", "eqeqeq"] } },
  "test": { "include": ["src/**/*.test.ts", "scripts/**/*.test.ts"] }
}
